# Token dari @BotFather
BOT_TOKEN=ISI_TOKEN_BOT_KAMU

# Lokasi Android SDK (wajib kalau build tanpa Docker)
ANDROID_HOME=/opt/android-sdk

# Perintah gradle (default: gradle)
GRADLE_BIN=gradle

# Untuk fitur Deploy website (token dari https://vercel.com/account/tokens)
VERCEL_TOKEN=
# Opsional: isi jika deploy ke Team Vercel
VERCEL_TEAM_ID=
