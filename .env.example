# Token dari @BotFather
BOT_TOKEN=
# Password untuk tombol ON/OFF di website dashboard (buat yang kuat)
ADMIN_PASSWORD=

# Port website dashboard
PORT=3000
# Bot otomatis menyala saat server start (kecuali terakhir dimatikan lewat dashboard)
AUTO_START=true

# Lokasi Android SDK dan perintah gradle (tidak perlu diubah jika memakai Docker)
ANDROID_HOME=/opt/android-sdk
GRADLE_BIN=gradle

# Maksimal antrian build dan batas waktu build (menit)
MAX_QUEUE=5
BUILD_TIMEOUT_MIN=20
