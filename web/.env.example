# ===== Wajib =====
BOT_TOKEN=            # token dari @BotFather (disarankan bot BARU, terpisah dari bot VPS)
ADMIN_PASSWORD=       # password untuk tombol ON/OFF di website (buat yang kuat)
GITHUB_TOKEN=         # Personal Access Token (scope: repo + workflow)
GITHUB_REPO=          # contoh: gilang/web2apk-builder  (repo dari folder builder-repo)

# ===== Sangat disarankan (penyimpan sesi percakapan bot) =====
# Pasang Upstash Redis dari Vercel Marketplace, variabel ini terisi otomatis:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Opsional =====
GITHUB_BRANCH=main
VERCEL_TOKEN=         # untuk fitur Deploy HTML/ZIP
VERCEL_TEAM_ID=       # isi jika deploy ke Team Vercel
